<UserControl x:Class="StoreShot.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StoreShot.App.ViewModels"
             xmlns:proj="clr-namespace:StoreShot.Core.Projects;assembly=StoreShot.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Turn an Android APK into store-ready listing screenshots for Google Play and the App Store." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New project" Padding="16,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="New project" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenProjectCommand}" AutomationProperties.Name="Open project" Padding="16,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Open project…" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CheckEnvironmentCommand}" AutomationProperties.Name="Check environment" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Check environment" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Current project -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Show folder" Command="{Binding ShowProjectFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Close project" Command="{Binding CloseProjectCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="OPEN PROJECT" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentProject.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,2"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding CurrentProject.Folder, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Next: import an APK and run it in the emulator (arrives in milestone M2)." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Recent projects" />

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel Margin="0,8">
                    <TextBlock Text="No projects yet" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Create a project to get started. Each project is a folder that holds your APK, captured screens and generated images." />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding RecentProjects}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type proj:RecentProject}">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenRecentCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}" />
                                    <Button ToolTip="Remove from list"
                                            Command="{Binding DataContext.RemoveRecentCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from recent list'}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding LastOpenedUtc, Converter={StaticResource RelativeTime}}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Missing"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
