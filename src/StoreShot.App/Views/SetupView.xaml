<UserControl x:Class="StoreShot.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StoreShot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             x:Name="Root">
    <DockPanel Margin="40,32,40,0">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Environment setup" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="SSGen runs your APK in the Android Emulator. This checks that everything it needs is installed, and helps fix what isn't." />

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Cancel" Command="{Binding RunChecksCancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding RunChecksCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Check again" Command="{Binding RunChecksCommand}" Margin="0,0,8,0" />
                        <Button Content="Continue" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ContinueCommand}" Padding="16,6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0"
                                   Text="{Binding OverallStatus, Converter={StaticResource StatusToGlyph}}"
                                   Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding OverallSummary}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Problems can also be fixed later. Settings lets you point to a custom SDK or Java folder." />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Value="{Binding Progress}" Height="3" Margin="0,0,0,12" AutomationProperties.Name="Check progress"
                         Visibility="{Binding RunChecksCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Checks -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,0,0,32" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheckItemViewModel}">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded}" Padding="8,4"
                                                  ToolTip="Show details"
                                                  AutomationProperties.Name="{Binding Title, StringFormat='Details for {0}'}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" />
                                    </ToggleButton>
                                    <Button DockPanel.Dock="Right" Content="{Binding Fix.Label}" Margin="0,0,8,0"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Command="{Binding DataContext.RunFixCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Width="22" Margin="0,0,12,0"
                                               Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                               AutomationProperties.Name="{Binding Status}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Purpose}" />
                                    </StackPanel>
                                </DockPanel>

                                <ProgressBar Margin="34,8,0,0" Height="4" IsIndeterminate="True"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Fix in progress -->
                                <StackPanel Margin="34,10,0,0" Visibility="{Binding IsFixing, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Height="4" Value="{Binding FixPercent, TargetNullValue=0}"
                                                 IsIndeterminate="{Binding IsFixIndeterminate, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding FixMessage}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Details -->
                                <StackPanel Margin="34,10,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Visibility="{Binding HasFixInstructions, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                        <TextBlock Text="How to fix" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding FixInstructions, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Details" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Details, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="Nothing more to show."
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
