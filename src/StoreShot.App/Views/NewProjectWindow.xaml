<Window x:Class="StoreShot.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24">
        <TextBlock Text="Create a project" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                   Text="A project is a folder holding your APK, captured screens and generated images. You'll import the APK on the Emulator page." />

        <Label Content="_Project name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" TextChanged="OnInputChanged" />

        <Label Content="_Location" Target="{Binding ElementName=FolderBox}" Padding="0,0,0,4" />
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" TextChanged="OnInputChanged" />
        </DockPanel>
        <TextBlock x:Name="PreviewText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CreateButton" Content="Create" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="90" Margin="0,0,8,0" Click="OnCreate" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
