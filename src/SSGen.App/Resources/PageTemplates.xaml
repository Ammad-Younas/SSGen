<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SSGen.App.ViewModels"
                    xmlns:views="clr-namespace:SSGen.App.Views">

    <!-- View-model-first navigation: each page view model renders with its view. -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmulatorViewModel}">
        <views:EmulatorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AgentViewModel}">
        <views:AgentView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DesignViewModel}">
        <views:DesignView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
        <views:GalleryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
        <views:EditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
        <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <views:PlaceholderView />
    </DataTemplate>
</ResourceDictionary>
