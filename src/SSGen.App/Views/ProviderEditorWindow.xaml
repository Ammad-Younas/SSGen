<Window x:Class="SSGen.App.Views.ProviderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI provider"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Text="Add an AI provider" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                   Text="Keys are encrypted with Windows DPAPI and stay on this PC. Local providers (Ollama, LM Studio) are free and keep screenshots on your machine." />

        <Label Content="_Type" Target="{Binding ElementName=TypeBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="TypeBox" Margin="0,0,0,12" SelectionChanged="OnTypeChanged" AutomationProperties.Name="Provider type">
            <ComboBoxItem Tag="Anthropic" Content="Anthropic (Claude), API key" />
            <ComboBoxItem Tag="OpenAI" Content="OpenAI, API key" />
            <ComboBoxItem Tag="Gemini" Content="Google Gemini, API key" />
            <ComboBoxItem Tag="OpenAICompatible" Content="OpenAI-compatible endpoint (OpenRouter, Groq, Together, LM Studio, llama.cpp…)" />
            <ComboBoxItem Tag="Ollama" Content="Ollama (local)" />
        </ComboBox>

        <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <Label Content="_Base URL" Target="{Binding ElementName=UrlBox}" Padding="0,0,0,4" />
        <TextBox x:Name="UrlBox" Margin="0,0,0,2" />
        <TextBlock x:Name="UrlHint" Style="{StaticResource Caption}" Margin="0,0,0,12" />

        <StackPanel x:Name="KeyPanel">
            <Label Content="API _key" Target="{Binding ElementName=KeyBox}" Padding="0,0,0,4" />
            <PasswordBox x:Name="KeyBox" Margin="0,0,0,2" AutomationProperties.Name="API key" />
            <TextBlock x:Name="KeyHint" Style="{StaticResource Caption}" Margin="0,0,0,12" />
        </StackPanel>

        <Label Content="_Model" Target="{Binding ElementName=ModelBox}" Padding="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Fetch models" Margin="8,0,0,0" Click="OnFetchModels" />
            <ComboBox x:Name="ModelBox" IsEditable="True" AutomationProperties.Name="Model" />
        </DockPanel>

        <Label Content="_Screenshots (vision)" Target="{Binding ElementName=VisionBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="VisionBox" Margin="0,0,0,2" AutomationProperties.Name="Vision">
            <ComboBoxItem Tag="Auto" Content="Detect automatically" IsSelected="True" />
            <ComboBoxItem Tag="Enabled" Content="Send screenshots" />
            <ComboBoxItem Tag="Disabled" Content="Don't send screenshots (UI text only)" />
        </ComboBox>
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                   Text="Models without vision still explore using the screen's UI text, but screen ranking will be weaker." />

        <Border x:Name="ResultBorder" Style="{StaticResource Card}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ResultIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBox x:Name="ResultText" Style="{StaticResource SelectableText}" />
            </DockPanel>
        </Border>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="Collapsed" />

        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Test connection" Click="OnTest" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,8,0" Click="OnSave" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
