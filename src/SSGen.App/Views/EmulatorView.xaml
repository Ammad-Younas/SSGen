<UserControl x:Class="SSGen.App.Views.EmulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             xmlns:dev="clr-namespace:SSGen.Emulator.Devices;assembly=SSGen.Emulator"
             xmlns:logcat="clr-namespace:SSGen.Emulator.Logcat;assembly=SSGen.Emulator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EmulatorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">
    <!-- Three resizable sections: device | screen | app & logcat. Splitter positions are remembered. -->
    <Grid Margin="20,20,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="270*" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="CenterColumn" Width="400*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="RightColumn" Width="340*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <GridSplitter x:Name="DeviceSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      AutomationProperties.Name="Resize device panel" />

        <!-- Collapse handle on the device divider (column 1 is the splitter's 14px column; negative margins keep it there). -->
        <Button x:Name="CollapseHandle" Grid.Column="1" Panel.ZIndex="1" Style="{StaticResource RoundHandleButton}"
                VerticalAlignment="Top" Margin="-5,74,-5,0" Command="{Binding ToggleDevicePanelCommand}"
                ToolTip="Collapse device panel" AutomationProperties.Name="Collapse device panel">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="10" />
        </Button>

        <!-- Collapsed device panel: a slim rail. Click it (or ») to expand; Stop stays reachable while running. -->
        <Border x:Name="DeviceRail" Grid.Column="0" Width="44" Visibility="Collapsed" Margin="0,0,10,0" CornerRadius="8" Cursor="Hand"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" MouseLeftButtonUp="OnRailClicked" ToolTip="Expand device panel"
                AutomationProperties.Name="Device panel (collapsed)">
            <DockPanel Margin="0,6">
                <Button DockPanel.Dock="Top" Style="{StaticResource IconButton}" Command="{Binding ToggleDevicePanelCommand}" HorizontalAlignment="Center"
                        Padding="8,6" ToolTip="Expand device panel" AutomationProperties.Name="Expand device panel">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Command="{Binding StopCommand}" HorizontalAlignment="Center"
                        Padding="8,6" ToolTip="Stop device" AutomationProperties.Name="Stop device"
                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Button>
                <Ellipse DockPanel.Dock="Top" Width="8" Height="8" Margin="0,10,0,10" HorizontalAlignment="Center"
                         Fill="{DynamicResource SystemFillColorSuccessBrush}" ToolTip="Running"
                         Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                <!-- Rotated after layout via a Canvas host so the text is measured along the rail's height, not its width. -->
                <Canvas x:Name="RailTitleHost" ClipToBounds="True" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="RailTitleText" Text="{Binding RailTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}" DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      AutomationProperties.Name="Resize log panel" />

        <!-- ============================== Device ============================== -->
        <ScrollViewer x:Name="DevicePanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Emulator" FontSize="24" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                           Text="Run the app on a virtual device (or a USB phone) and see its screen live." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Refresh device list"
                                    AutomationProperties.Name="Refresh devices" Padding="8,4">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                            </Button>
                            <TextBlock Text="Device" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="Device">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dev:DeviceTarget}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="● Running" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Start" Style="{DynamicResource AccentButtonStyle}" Command="{Binding StartCommand}" Margin="0,0,6,6" MinWidth="70" />
                            <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,6,6" MinWidth="70" />
                            <Button Content="Reset…" Command="{Binding ResetCommand}" Margin="0,0,6,6"
                                    ToolTip="Erase all data on a SSGen-created device and start it fresh" />
                            <Button Content="Delete…" Command="{Binding DeleteDeviceCommand}" Margin="0,0,6,6"
                                    ToolTip="Delete a SSGen-created device" />
                        </WrapPanel>
                        <CheckBox Content="Show emulator window too" IsChecked="{Binding ShowEmulatorWindow}" Margin="0,4,0,0"
                                  ToolTip="Takes effect the next time the device starts" />

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Expander Header="Create a virtual device" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <Label Content="Screen" Padding="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,0,8" AutomationProperties.Name="Screen profile" />
                        <Label Content="Android version (installed images)" Padding="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Margin="0,0,0,8" AutomationProperties.Name="System image">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="API" /> <Run Text="{Binding ApiLevel, Mode=OneWay}" /> <Run Text="·" />
                                        <Run Text="{Binding Platform, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Tag, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Label Content="Name" Padding="0,0,0,2" />
                        <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Device name" />
                        <Button Content="Create device" Command="{Binding CreateDeviceCommand}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Missing an Android version? Install more system images on the Environment page." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== Preview ============================== -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <WrapPanel HorizontalAlignment="Center">
                    <Button Command="{Binding BackCommand}" ToolTip="Back" AutomationProperties.Name="Back" Margin="3" Padding="12,6"
                            IsEnabled="{Binding HasDevice}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" />
                    </Button>
                    <Button Command="{Binding HomeCommand}" ToolTip="Home" AutomationProperties.Name="Home" Margin="3" Padding="12,6"
                            IsEnabled="{Binding HasDevice}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                    </Button>
                    <Button Command="{Binding RecentsCommand}" ToolTip="Recent apps" AutomationProperties.Name="Recent apps" Margin="3" Padding="12,6"
                            IsEnabled="{Binding HasDevice}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C4;" />
                    </Button>
                    <Button Command="{Binding CaptureScreenCommand}" AutomationProperties.Name="Capture screen" Margin="3" Padding="12,6"
                            ToolTip="Save the current screen into the project">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Margin="0,0,6,0" />
                            <TextBlock Text="Capture" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <DockPanel Margin="3,4,3,0" MaxWidth="360">
                    <Button DockPanel.Dock="Right" Content="Type" Command="{Binding SendTextCommand}" Margin="6,0,0,0" IsEnabled="{Binding HasDevice}" />
                    <TextBox Text="{Binding TextToSend, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text to type"
                             ToolTip="Type text into the focused field on the device (Enter sends)" IsEnabled="{Binding HasDevice}" KeyDown="OnTextBoxKeyDown" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0">
                    <Run Text="{Binding MirrorInfo, Mode=OneWay}" />
                    <Run x:Name="FpsRun" Text="" />
                    <LineBreak />
                    <Run Text="{Binding CapturedText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <!-- The dark frame exists only while a device is running and hugs the device image (Stretch=Uniform). -->
            <Grid>
                <Border CornerRadius="14" Background="#FF101010" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                    <Image x:Name="Preview" Stretch="Uniform" Cursor="Hand" Focusable="True" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Device screen. Click to tap, drag to swipe, type to send keys."
                           MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove" MouseLeftButtonUp="OnPreviewMouseUp"
                           MouseWheel="OnPreviewMouseWheel" KeyDown="OnPreviewKeyDown" TextInput="OnPreviewTextInput"
                           Margin="8" />
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                            Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Start a device to see its screen here" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Click to tap · drag to swipe · scroll to scroll · type to send keys"
                               Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ============================== App + Logcat ============================== -->
        <!-- Own tab strip instead of TabControl: the Fluent TabControl hosts content without a height constraint,
             which left the log list unbounded (no scrolling). This Grid row gives each panel a real viewport. -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="AppTab" Content="App" GroupName="EmulatorTabs" IsChecked="True" Style="{StaticResource TabStripButton}" />
                <RadioButton x:Name="LogTab" Content="Logcat" GroupName="EmulatorTabs" Style="{StaticResource TabStripButton}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=AppTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Style="{StaticResource Caption}" Text="Open or create a project on the Home page to import an APK and save captured screens." />
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasApk, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="12" ClipToBounds="True" Margin="0,0,12,0"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="{Binding ApkIcon}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Apk.Info.DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Apk.Info.PackageName, Mode=OneWay}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ApkSummary}" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                    <Run Text="Permissions:" /> <Run Text="{Binding Apk.Info.Permissions.Count, Mode=OneWay}" />
                                    <Run Text="· launcher:" /> <Run Text="{Binding Apk.Info.LauncherActivity, Mode=OneWay, TargetNullValue='none'}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Apk.Warnings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding StringFormat='⚠ {0}'}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Install &amp; open" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallAndLaunchCommand}" Margin="0,0,6,6" />
                                    <Button Content="Open app" Command="{Binding LaunchAppCommand}" Margin="0,0,6,6" />
                                    <Button Content="Replace APK…" Command="{Binding ImportApkCommand}" Margin="0,0,6,6" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Runtime permissions are granted automatically on install."
                                           Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Border.Visibility>
                                <MultiBinding Converter="{x:Static vm:EmulatorViewHelpers.ShowImportCard}">
                                    <Binding Path="HasProject" />
                                    <Binding Path="HasApk" />
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="No APK imported yet" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                                           Text="Import your app's .apk. SSGen reads its name, icon, version and permissions, and keeps a copy in the project." />
                                <Button Content="Import APK…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ImportApkCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="1" Visibility="{Binding IsChecked, ElementName=LogTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Left" Width="118" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding MinLogLevel}"
                                      AutomationProperties.Name="Minimum log level" Margin="0,0,6,0" />
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogsCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Filter logs"
                                     ToolTip="Filter by tag or message" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox Content="This app only" IsChecked="{Binding OnlyAppLogs}" Margin="0,0,16,0" />
                            <CheckBox Content="Pause" IsChecked="{Binding LogsPaused}" />
                        </StackPanel>
                    </StackPanel>
                    <ListView ItemsSource="{Binding Logs}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Log messages"
                              Loaded="OnLogListLoaded" IsVisibleChanged="OnLogListVisibleChanged" PreviewMouseWheel="OnLogMouseWheel">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type logcat:LogcatEntry}">
                                <TextBlock x:Name="Line" TextWrapping="NoWrap">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{Binding LevelLetter, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding Tag, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
