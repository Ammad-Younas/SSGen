<UserControl x:Class="SSGen.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Changes are saved automatically." />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE790;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Appearance" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                              AutomationProperties.Name="Theme" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Theme" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="System follows your Windows light/dark setting." />
                    </StackPanel>
                </DockPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- Tools -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE90F;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Android tools" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Browse" Command="{Binding BrowseSdkCommand}" Margin="0,0,8,0" />
                            <Button Content="Auto-detect" Command="{Binding ResetSdkCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Android SDK folder" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding AndroidSdkPath, TargetNullValue='Auto-detect (ANDROID_HOME, ANDROID_SDK_ROOT, or %LOCALAPPDATA%\\Android\\Sdk)'}" />
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Browse" Command="{Binding BrowseJavaCommand}" Margin="0,0,8,0" />
                            <Button Content="Auto-detect" Command="{Binding ResetJavaCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Java home (optional)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding JavaHomePath, TargetNullValue='Auto-detect (JAVA_HOME, Android Studio JDK, or PATH)'}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- Projects -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8B7;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Projects" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Browse" Command="{Binding BrowseProjectsCommand}" Margin="0,0,8,0" />
                        <Button Content="Default" Command="{Binding ResetProjectsCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Default location for new projects" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProjectsFolder, TargetNullValue={x:Static vm:SettingsViewModelDefaults.ProjectsFolder}}" />
                    </StackPanel>
                </DockPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- Agent safety -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xEA18;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Exploration safety" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SafeMode}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Safe mode" />
                        <StackPanel>
                            <TextBlock Text="Safe mode (recommended)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="On: the agent never performs purchase, payment, delete, send, post, share or sign-out actions. Off: it asks you before each one." />
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,12" />
                    <TextBlock Text="Extra blocked words" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="Added to the built-in list (buy, pay, subscribe, delete, send, post, share, sign out… in several languages). One per line or comma-separated." />
                    <TextBox Text="{Binding Ai.BlocklistExtra, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra blocked words" />
                </StackPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- AI -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE945;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="AI providers" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Add provider" Command="{Binding Ai.AddProviderCommand}"
                                Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding Ai.ActiveSummary}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="SSGen doesn't ship with or default to any provider. Without one, exploration uses the systematic (no-AI) explorer and everything else works manually." />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Ai.Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.Ai.EditProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.Ai.DeleteProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding TypeName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Model, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EffectiveBaseUrl, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Ai.HasProfiles, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,8,0,12" />
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="260" ItemsSource="{Binding Ai.Profiles}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Ai.ActiveProfile}" AutomationProperties.Name="Active provider" />
                            <StackPanel>
                                <TextBlock Text="Active provider" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Used for every task that doesn't have its own model below." />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Model per task" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="Optional. Leave the provider on 'Active provider' and the model empty to use the defaults." />
                        <ItemsControl ItemsSource="{Binding Ai.Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Purpose}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.Ai.TaskProfileChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}"
                                                  AutomationProperties.Name="{Binding Title}" />
                                        <TextBox Grid.Column="2" VerticalAlignment="Center" Text="{Binding Model, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                 ToolTip="Model override (empty = the profile's model)" AutomationProperties.Name="Model override" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- Cost -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8C7;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="AI cost control" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <StackPanel>
                    <DockPanel>
                        <TextBox DockPanel.Dock="Right" Width="120" Text="{Binding Ai.CostCap, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Cost cap in US dollars" />
                        <StackPanel>
                            <TextBlock Text="Spending cap per run (USD)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Applies to paid cloud providers only; local providers are free. Empty = you'll be asked before the first paid run. The run stops when the estimate reaches the cap." />
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Add model" Command="{Binding Ai.AddPriceCommand}" Margin="0,0,8,0" />
                            <Button Content="Save prices" Command="{Binding Ai.SavePricesCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Model prices (USD per million tokens)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="SSGen doesn't assume prices. Copy them from your provider's pricing page; without a price the cost shows as unknown and only token counts are tracked." />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Ai.Prices}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Model}" Margin="0,0,8,0" AutomationProperties.Name="Model name" ToolTip="Model name, exactly as configured" />
                                    <TextBox Grid.Column="1" Text="{Binding Input}" Margin="0,0,8,0" AutomationProperties.Name="Input price" ToolTip="Input (prompt) price per million tokens" />
                                    <TextBox Grid.Column="2" Text="{Binding Output}" Margin="0,0,8,0" AutomationProperties.Name="Output price" ToolTip="Output price per million tokens" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="Remove"
                                            Command="{Binding DataContext.Ai.RemovePriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Remove price" ><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" /></Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Ai.CloudConsent}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Allow sending screenshots to cloud providers" />
                        <StackPanel>
                            <TextBlock Text="Allow sending screenshots to cloud providers" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Asked the first time a cloud model would see your app. Untick to be asked again. Local providers never need this." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- Privacy & data -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE72E;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Privacy and data" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <StackPanel>
                    <TextBlock Text="No telemetry" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="SSGen collects and sends no usage data. API keys are encrypted with Windows DPAPI and only readable by your Windows account." />
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear cache" Command="{Binding ClearCacheCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Cache" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CacheSize, StringFormat='{}{0} used'}" />
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Export logs" Command="{Binding ExportLogsCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Logs" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Useful when reporting a problem. Kept for 14 days." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                </Border>
                </DockPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE946;" /></Border>
                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="About" />
                    </StackPanel>
                </Border>
                <Border Padding="16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="SSGen" /> <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding DataFolder, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
                </Border>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
