<UserControl x:Class="SSGen.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             xmlns:ctl="clr-namespace:SSGen.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- Numbers commit on Enter or when leaving the box. -->
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="0" />
            <EventSetter Event="KeyDown" Handler="OnNumberKeyDown" />
        </Style>

        <!-- A label above a slider with its value on the right. -->
        <DataTemplate x:Key="FillEditor" DataType="{x:Type vm:FillEditorViewModel}">
            <StackPanel>
                <ComboBox ItemsSource="{x:Static vm:FillEditorViewModel.Kinds}" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Fill type" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Colour" />
                <ctl:ColorBox Color="{Binding Color1, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                <StackPanel Visibility="{Binding IsGradient, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Second colour" />
                    <ctl:ColorBox Color="{Binding Color2, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsLinear, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Angle, StringFormat='{}{0:0}°'}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Direction" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="360" Value="{Binding Angle}" AutomationProperties.Name="Gradient direction" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title and image picker -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource IconButton}" Command="{Binding PreviousImageCommand}" ToolTip="Previous image" AutomationProperties.Name="Previous image" Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" />
                </Button>
                <ComboBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" MinWidth="320" MaxWidth="460" DisplayMemberPath="Title"
                          AutomationProperties.Name="Image to edit" />
                <Button Style="{StaticResource IconButton}" Command="{Binding NextImageCommand}" ToolTip="Next image" AutomationProperties.Name="Next image" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Editor" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" Text="Fine-tune any store image: text, colours, shapes, pictures, frames and filters." />
            </StackPanel>
        </DockPanel>

        <!-- Nothing to edit -->
        <Border Grid.Row="1" Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE946;" /></Border>
                <Button DockPanel.Dock="Right" Content="Go to Design" Command="{Binding GoDesignCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,10" IsEnabled="{Binding HasDocument}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,0" ToolTip="Discard the changes since the last save" />
                    <Button Content="Save" Command="{Binding SaveChangesCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80" ToolTip="Save (Ctrl+S)" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoText}" AutomationProperties.Name="Undo">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoText}" AutomationProperties.Name="Redo" Margin="2,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" FontSize="14" />
                    </Button>
                    <Border Width="1" Margin="0,4,12,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Button Command="{Binding AddTextCommand}" Margin="0,0,6,0" ToolTip="Add a text box" AutomationProperties.Name="Add text">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Text" /></StackPanel>
                    </Button>
                    <Button Command="{Binding AddRectangleCommand}" Margin="0,0,6,0" ToolTip="Add a rectangle" AutomationProperties.Name="Add rectangle">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE739;" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Rectangle" /></StackPanel>
                    </Button>
                    <Button Command="{Binding AddEllipseCommand}" Margin="0,0,6,0" ToolTip="Add an ellipse" AutomationProperties.Name="Add ellipse">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA3A;" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Ellipse" /></StackPanel>
                    </Button>
                    <Button Command="{Binding AddPictureCommand}" Margin="0,0,12,0" ToolTip="Add a picture from a file (logo, badge, sticker)" AutomationProperties.Name="Add picture">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Picture" /></StackPanel>
                    </Button>
                    <Border Width="1" Margin="0,4,12,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Button Content="Apply style to all" Command="{Binding ApplyStyleToAllCommand}" Margin="0,0,12,0"
                            ToolTip="Give the other images of this size the same look; each keeps its own headline and screenshot" />
                    <Border Width="1" Margin="0,4,12,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <RadioButton x:Name="ZoomFit" Content="Fit" GroupName="Zoom" IsChecked="True" Style="{StaticResource TabStripButton}" Checked="OnZoomChanged" />
                    <RadioButton x:Name="Zoom50" Content="50%" GroupName="Zoom" Style="{StaticResource TabStripButton}" Checked="OnZoomChanged" />
                    <RadioButton x:Name="Zoom100" Content="100%" GroupName="Zoom" Style="{StaticResource TabStripButton}" Checked="OnZoomChanged" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayersColumn" Width="260*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CanvasColumn" Width="640*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="320*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Layers ============================ -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE81E;" /></Border>
                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Layers" />
                            <Border Style="{StaticResource CountBadge}"><TextBlock Style="{StaticResource Caption}" Text="{Binding Layers.Count}" HorizontalAlignment="Center" /></Border>
                        </StackPanel>
                    </Border>
                    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="10,6,10,10">
                        <Button Style="{StaticResource IconButton}" Command="{Binding BringForwardCommand}" ToolTip="Bring forward" AutomationProperties.Name="Bring forward" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding SendBackwardCommand}" ToolTip="Send backward" AutomationProperties.Name="Send backward" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateLayerCommand}" ToolTip="Duplicate (Ctrl+D)" AutomationProperties.Name="Duplicate layer" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding DeleteLayerCommand}" ToolTip="Delete (Del)" AutomationProperties.Name="Delete layer" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                        </Button>
                    </UniformGrid>
                    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Layers">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LayerItemViewModel}">
                                <DockPanel AutomationProperties.Name="{Binding Name}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                               ToolTip="{Binding KindName}" />
                                    <Button x:Name="LockButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,4" ToolTip="Lock (can't be selected on the canvas)"
                                            Command="{Binding DataContext.ToggleLockCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="Lock layer">
                                        <TextBlock x:Name="LockGlyph" Style="{StaticResource Icon}" Text="&#xE785;" FontSize="12" Opacity="0.45" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,4" ToolTip="Show or hide"
                                            Command="{Binding DataContext.ToggleVisibleCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="Show or hide layer">
                                        <TextBlock x:Name="EyeGlyph" Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="12" />
                                    </Button>
                                    <TextBlock x:Name="LayerName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                        <Setter TargetName="EyeGlyph" Property="Text" Value="&#xED1A;" />
                                        <Setter TargetName="LayerName" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                        <Setter TargetName="LockGlyph" Property="Text" Value="&#xE72E;" />
                                        <Setter TargetName="LockGlyph" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize layers panel"
                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

            <!-- ============================ Canvas ============================ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                       Text="{Binding Status}" ToolTip="{Binding Status}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE70F;" /></Border>
                                <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Canvas area"
                                  Background="{DynamicResource SubtleFillColorTertiaryBrush}" SizeChanged="OnCanvasAreaSizeChanged">
                        <Grid x:Name="Stage" Width="{Binding DocWidth}" Height="{Binding DocHeight}" Margin="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Focusable="True"
                              FocusVisualStyle="{x:Null}" ClipToBounds="False"
                              MouseLeftButtonDown="OnStageMouseDown" MouseMove="OnStageMouseMove" MouseLeftButtonUp="OnStageMouseUp"
                              LostMouseCapture="OnStageLostCapture" AutomationProperties.Name="Canvas">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="StageScale" ScaleX="0.3" ScaleY="0.3" />
                            </Grid.LayoutTransform>
                            <Border Background="White">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
                                </Border.Effect>
                            </Border>
                            <Image Source="{Binding Canvas}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize properties panel"
                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

            <!-- ============================ Properties ============================ -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE713;" /></Border>
                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Properties" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="16,8,16,16">
                            <!-- Nothing selected: the canvas itself -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ContentPresenter Content="{Binding Background}" ContentTemplate="{StaticResource FillEditor}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,0"
                                           Text="Click a layer on the canvas or in the Layers list to change it. Drag to move, drag a corner to resize (Shift: free proportions for pictures, keep them for the rest), drag the round handle to rotate (Shift: 15° steps). Arrow keys nudge, Delete removes, Ctrl+D duplicates." />
                            </StackPanel>

                            <!-- A layer -->
                            <StackPanel DataContext="{Binding Properties}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding KindTitle}" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Layer name" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Layer name" />

                                <!-- Text -->
                                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Text" />
                                    <TextBox x:Name="LayerText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                             AutomationProperties.Name="Text" />
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Font" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.FontFamilies, ElementName=Root}" Text="{Binding Font, UpdateSourceTrigger=LostFocus}"
                                                      AutomationProperties.Name="Font" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Size" />
                                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Font size" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Weight" />
                                    <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.Weights}" SelectedValuePath="Weight" DisplayMemberPath="Name"
                                              SelectedValue="{Binding Weight}" HorizontalAlignment="Stretch" AutomationProperties.Name="Font weight" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Colour" />
                                    <ctl:ColorBox Color="{Binding TextColor, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Align" />
                                            <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.Aligns}" SelectedItem="{Binding Align}" HorizontalAlignment="Stretch" AutomationProperties.Name="Text alignment" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="In the box" />
                                            <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.VerticalAligns}" SelectedItem="{Binding VerticalAlign}" HorizontalAlignment="Stretch" AutomationProperties.Name="Vertical alignment" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Line height" />
                                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding LineHeight, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Line height" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Spacing" />
                                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding LetterSpacing, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Letter spacing" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Max lines" />
                                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding MaxLines, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Maximum lines" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Text shrinks to fit its box, so long translations still fit." />
                                </StackPanel>

                                <!-- Shape -->
                                <StackPanel Visibility="{Binding IsShape, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Shape" />
                                    <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.Shapes}" SelectedItem="{Binding ShapeKind}" HorizontalAlignment="Stretch" AutomationProperties.Name="Shape" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fill" />
                                    <ContentPresenter Content="{Binding Fill}" ContentTemplate="{StaticResource FillEditor}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Blur}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Soft edge (blur)" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="200" Value="{Binding Blur}" AutomationProperties.Name="Blur" />
                                    <CheckBox Content="Outline" IsChecked="{Binding HasStroke}" Margin="0,8,0,0" />
                                    <Grid Visibility="{Binding HasStroke, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Outline colour" />
                                            <ctl:ColorBox Color="{Binding StrokeColor, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Width" />
                                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding StrokeWidth, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Outline width" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Corner radius (shapes and pictures) -->
                                <StackPanel Visibility="{Binding HasRadius, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Corner radius" />
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Radius, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Corner radius" />
                                </StackPanel>

                                <!-- Picture -->
                                <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fit" />
                                    <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.Fits}" SelectedItem="{Binding Fit}" HorizontalAlignment="Stretch" AutomationProperties.Name="Picture fit" />
                                </StackPanel>

                                <!-- Device -->
                                <StackPanel Visibility="{Binding IsDevice, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Frame" />
                                    <ComboBox ItemsSource="{x:Static vm:LayerPropertiesViewModel.Frames}" SelectedItem="{Binding Frame}" HorizontalAlignment="Stretch" AutomationProperties.Name="Device frame" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Frame colour" />
                                    <ctl:ColorBox Color="{Binding FrameColor, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                                </StackPanel>

                                <!-- Filters (pictures and screenshots) -->
                                <StackPanel Visibility="{Binding HasAdjust, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,14,0,0">
                                        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding DataContext.ResetFiltersCommand, ElementName=Root}" Padding="10,2" />
                                        <TextBlock Text="Filters" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Brightness}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Brightness" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" AutomationProperties.Name="Brightness" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Contrast}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Contrast" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" AutomationProperties.Name="Contrast" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Saturation}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Saturation" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" AutomationProperties.Name="Saturation" />
                                </StackPanel>

                                <!-- Position -->
                                <TextBlock Text="Position and size" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="X" />
                                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding X, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="X position" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Y" />
                                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Y position" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width" />
                                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding W, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Width" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height" />
                                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding H, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Height" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Rotation, StringFormat='{}{0:0.#}°'}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation" />
                                </DockPanel>
                                <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" AutomationProperties.Name="Rotation" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Opacity, StringFormat='{}{0:0}%'}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Opacity}" AutomationProperties.Name="Opacity" />

                                <!-- Shadow -->
                                <CheckBox Content="Shadow" IsChecked="{Binding HasShadow}" Margin="0,12,0,0" FontWeight="SemiBold" />
                                <StackPanel Visibility="{Binding HasShadow, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding ShadowBlur}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Softness" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="200" Value="{Binding ShadowBlur}" AutomationProperties.Name="Shadow softness" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding ShadowOffsetY}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Distance" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding ShadowOffsetY}" AutomationProperties.Name="Shadow distance" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Shadow colour" />
                                    <ctl:ColorBox Color="{Binding ShadowColor, Mode=TwoWay}" Swatches="{Binding DataContext.Swatches, ElementName=Root}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
