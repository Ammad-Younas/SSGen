<UserControl x:Class="SSGen.App.Views.AgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             xmlns:ctl="clr-namespace:SSGen.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AgentViewModel}">
    <UserControl.Resources>
        <!-- Updated from code as the screens panel is resized, so thumbnails fill its height. -->
        <sys:Double x:Key="ThumbImageHeight">190</sys:Double>

        <!-- A card header that becomes the whole (rounded) card when its section is closed. Tag = open. -->
        <Style x:Key="CollapsibleHeader" TargetType="Border" BasedOn="{StaticResource PanelHeader}">
            <Setter Property="Padding" Value="16,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Down arrow when closed, up arrow when open (white on the red pressed state). -->
        <Style x:Key="CollapseArrow" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="&#xE70D;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Text" Value="&#xE70E;" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="Explore" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0"
                       Text="The agent walks through your app on the running device and saves every distinct screen to the project." />
        </StackPanel>

        <!-- Takeover: pinned under the title (always visible) while the user has control of the device. -->
        <!-- After a run: what was found, and the way on to Design (pinned above the panels so it's always seen). -->
        <Border Grid.Row="1" Visibility="{Binding FinishedMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,4" Margin="8,0,0,0" Command="{Binding DismissFinishedCommand}"
                        ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                </Button>
                <Button DockPanel.Dock="Right" Content="Continue to Design" Command="{Binding ContinueToDesignCommand}" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock Text="{Binding FinishedMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Visibility="{Binding IsTakenOver, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE7EF;" /></Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Open Emulator" Command="{Binding OpenEmulatorCommand}" Margin="0,0,8,0" />
                    <Button Content="Resume" Command="{Binding ResumeFromTakeoverCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                            AutomationProperties.Name="Resume exploring" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="You have control" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding TakeoverReason}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Controls | rest. Minimum widths fit the smallest window (900 px with the nav expanded). -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlsColumn" Width="300*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RestColumn" Width="900*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Get ready: checklist of prerequisites, shown until all are done. -->
                    <Border Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8"
                            CornerRadius="8" BorderThickness="1" Padding="16,14"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelHeaderIconTile}" VerticalAlignment="Top"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE946;" /></Border>
                                <StackPanel>
                                    <TextBlock Text="Get ready to explore" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ReadySteps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReadyStep}">
                                        <DockPanel Margin="0,3" ToolTip="{Binding Hint}">
                                            <TextBlock x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"
                                                       Text="&#xEA3A;" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock x:Name="Label" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xE930;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding FixActionText}" Command="{Binding GoToFixCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="120" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource CollapsibleHeader}" Tag="{Binding ShowSettings}">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Padding="8,4" IsChecked="{Binding ShowSettings}" ToolTip="Show or hide"
                                                  AutomationProperties.Name="Show explorer settings">
                                        <TextBlock Style="{StaticResource CollapseArrow}" />
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE713;" /></Border>
                                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Explorer settings" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        <StackPanel IsEnabled="{Binding IsIdle}" Margin="16,12,16,16" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Use AI" IsChecked="{Binding UseAi}" IsEnabled="{Binding AiAvailable}"
                                      AutomationProperties.Name="Use AI" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding AiDescription}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Without AI, the systematic explorer tries every button, tab and list once, scrolls, and goes back." />

                            <TextBlock Text="Hints for the AI (optional)" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBox Text="{Binding Hints, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                     AutomationProperties.Name="Hints" ToolTip="e.g. 'Create a sample note first so the list isn't empty'" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Max steps" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBox Text="{Binding MaxSteps}" AutomationProperties.Name="Max steps" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max minutes" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBox Text="{Binding MaxMinutes}" AutomationProperties.Name="Max minutes" />
                                </StackPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding CleanStatusBar}" Margin="0,12,0,0" AutomationProperties.Name="Clean status bar">
                                <TextBlock Text="Clean status bar (9:41, full battery, no notifications)" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="Screenshots wanted" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBox Text="{Binding TargetScreens}" AutomationProperties.Name="Screenshots wanted" Width="80" HorizontalAlignment="Left"
                                     ToolTip="How many store screenshots you want (1 to 10). Guides the AI; used when picking screens later." />
                        </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Sign-in: how to get past login walls. -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource CollapsibleHeader}" Tag="{Binding ShowSignIn}">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Padding="8,4" IsChecked="{Binding ShowSignIn}" ToolTip="Show or hide"
                                                  AutomationProperties.Name="Show sign-in settings">
                                        <TextBlock Style="{StaticResource CollapseArrow}" />
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE77B;" /></Border>
                                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Sign-in" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        <StackPanel IsEnabled="{Binding IsIdle}" Margin="16,12,16,16" Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="If the app asks you to sign in, the agent uses a test account (typed directly, never sent to an AI), or a guest option." />
                            <TextBlock Text="Test account user name or email" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Test account user name" />
                            <TextBlock Text="Password" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <PasswordBox x:Name="LoginPassword" LostFocus="OnPasswordLostFocus" AutomationProperties.Name="Test account password" />
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Content="Forget" Command="{Binding ClearPasswordCommand}" Padding="8,2" />
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="A password is saved (encrypted on this PC)." />
                            </DockPanel>
                            <TextBlock Text="Or continue without an account (optional)" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBox Text="{Binding LoginGuestHint, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Guest instruction"
                                     ToolTip="e.g. Tap 'Continue as guest'. Guest, Skip and Not now buttons are tried anyway." />
                            <CheckBox IsChecked="{Binding LoginAskUser}" Margin="0,10,0,0" AutomationProperties.Name="Ask me to log in if nothing works">
                                <TextBlock Text="If none of this works, pause and ask me to log in" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Payment, checkout and banking screens are never filled in: the agent pauses and gives you control, then continues when you press Resume." />
                        </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE768;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Run" />
                                </StackPanel>
                            </Border>
                        <StackPanel Margin="16,12,16,16">
                            <WrapPanel>
                                <Button Content="Start" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80" Margin="0,0,8,4" />
                                <Button Content="Continue last run" Command="{Binding ResumeLastCommand}" Margin="0,0,8,4"
                                        Visibility="{Binding CanResumeLast, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Pick up where the last run stopped: its screens and what was already tried are kept." />
                                <Button Command="{Binding PauseCommand}" MinWidth="80" Margin="0,0,8,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Pause" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Content" Value="Resume" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Take over" Command="{Binding TakeOverCommand}" Margin="0,0,8,4"
                                        ToolTip="Pause the agent and use the device yourself (e.g. to log in), then Resume." />
                                <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="80" Margin="0,0,8,4" />
                                <Button Content="Continue to Design" Command="{Binding ContinueToDesignCommand}" Margin="0,0,0,4"
                                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="The captured screens are saved in the project: rank them, add captions and render on the Design page." />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding LastRunText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding LastRunText, Converter={StaticResource NullToVisibility}}" />
                            <ProgressBar IsIndeterminate="{Binding IsRunning}" Height="3" Margin="0,8,0,0"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Status, Mode=OneWay}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Progress}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Meter}" TextWrapping="Wrap" />
                        </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize controls panel"
                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

            <!-- Top (screen | activity) / discovered screens -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRow" Height="600*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ScreensRow" Height="280*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ScreenColumn" Width="380*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ActivityColumn" Width="520*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Current screen -->
                    <Border Style="{StaticResource Card}" Margin="0" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <DockPanel>
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8EA;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Current screen" />
                                </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentScreenName}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="16,8,16,0" ToolTip="{Binding CurrentScreenName}" />
                            <Grid Margin="12">
                                <TextBlock Style="{StaticResource Caption}" Text="The current screen appears here while exploring." TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding CurrentScreen, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                <Image Source="{Binding CurrentScreen}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize current screen panel"
                                  DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

                    <!-- Activity / screen map -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="LogRow" Height="300*" MinHeight="90" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="MapRow" Height="300*" MinHeight="130" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <Border Style="{StaticResource PanelHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE81C;" /></Border>
                                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Activity" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                                         AutomationProperties.Name="Agent activity">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="12,3" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AgentLogLine}">
                                            <DockPanel ToolTip="{Binding Kind}">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Caption}" Width="58" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" AutomationProperties.Name="Resize activity and screen map"
                                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

                            <DockPanel Grid.Row="2">
                                <Border Style="{StaticResource PanelHeader}" BorderThickness="0,1,0,1" CornerRadius="0" Padding="16,7">
                                    <DockPanel>
                                        <!-- Diagram / list switch -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <RadioButton Content="Diagram" GroupName="MapMode" IsChecked="{Binding MapAsGraph}" Style="{StaticResource TabStripButton}" Margin="0,0,4,0" />
                                            <RadioButton Content="List" GroupName="MapMode" Style="{StaticResource TabStripButton}"
                                                         IsChecked="{Binding MapAsGraph, Converter={StaticResource InvertBool}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE81E;" /></Border>
                                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Screen map" />
                                            <Border Style="{StaticResource CountBadge}" ToolTip="Links between screens">
                                                <TextBlock Text="{Binding Map.Count}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- One fill area for both views (a DockPanel would dock the diagram left at zero width). -->
                                <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding MapAsGraph, Converter={StaticResource BoolToVisibility}}">
                                    <ctl:ScreenMapView Nodes="{Binding MapNodes}" Edges="{Binding MapEdges}" AutomationProperties.Name="Screen map diagram"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </ScrollViewer>
                                <ListBox ItemsSource="{Binding Map}" BorderThickness="0" Background="Transparent"
                                         Visibility="{Binding MapAsGraph, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Screen map">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" AutomationProperties.Name="Resize discovered screens panel"
                              DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

                <!-- Discovered screens -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" Padding="16,7">
                            <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Clear" Command="{Binding ClearDiscoveredCommand}" Margin="0,0,8,0"
                                        ToolTip="Forget the discovered screens and screen map (screenshots already moved to Design stay)" />
                                <Button Content="Continue to Design" Command="{Binding ContinueToDesignCommand}" Style="{DynamicResource AccentButtonStyle}"
                                        ToolTip="Move these screenshots to the Screens panel on the Design page" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE91B;" /></Border>
                                <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Discovered screens" />
                                <Border Style="{StaticResource CountBadge}" ToolTip="Unique screens found in this run">
                                    <TextBlock Text="{Binding Screens.Count}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer x:Name="ThumbScroller" Margin="16,12,16,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Discovered screens">
                            <ItemsControl ItemsSource="{Binding Screens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ScreenThumbViewModel}">
                                        <!-- Only the image sets the width: the caption sits in a Canvas (which asks for no width)
                                             and trims to the thumbnail, so long screen names never push items apart. -->
                                        <StackPanel Margin="0,0,12,0">
                                            <Image Source="{Binding Image}" Height="{DynamicResource ThumbImageHeight}" Stretch="Uniform" />
                                            <Canvas Height="18" ClipToBounds="True">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding Title}"
                                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                                            </Canvas>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
