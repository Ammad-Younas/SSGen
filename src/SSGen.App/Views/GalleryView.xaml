<UserControl x:Class="SSGen.App.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel}"
             x:Name="Root">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Delete all images" Command="{Binding DeleteAllCommand}" Margin="0,0,8,0"
                        ToolTip="Delete every store image of this project (and editor changes); render again on the Design page" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Gallery" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" Text="Your store images by store and size, checked against the store rules. Double-click an image to edit it." />
            </StackPanel>
        </DockPanel>

        <!-- Nothing rendered yet -->
        <Border Grid.Row="1" Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE946;" /></Border>
                <Button DockPanel.Dock="Right" Content="Go to Design" Command="{Binding GoDesignCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Store sizes -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Images" GroupName="GalleryMode" Style="{StaticResource TabStripButton}"
                             IsChecked="{Binding ShowListing, Converter={StaticResource InvertBool}}" />
                <RadioButton Content="Listing preview" GroupName="GalleryMode" IsChecked="{Binding ShowListing}" Style="{StaticResource TabStripButton}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource TabStripItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Store sizes">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GalleryGroupViewModel}">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="6,2,0,0" ToolTip="Some images need attention"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0" DataContext="{Binding SelectedGroup}"
                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Text="{Binding DataContext.Summary, ElementName=Root}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8B9;" /></Border>
                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="{Binding Title}" />
                            <Border Style="{StaticResource CountBadge}"><TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" HorizontalAlignment="Center" /></Border>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Problems with the set as a whole (counts) -->
                <Border DockPanel.Dock="Top" Margin="16,12,16,0" CornerRadius="6" Padding="10,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding HasSetIssues, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SetIssueText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <Grid>
                    <!-- ============ Images ============ -->
                    <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding DataContext.SelectedImage, ElementName=Root}"
                             BorderThickness="0" Background="Transparent" Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.Name="Images"
                             Visibility="{Binding DataContext.ShowListing, ElementName=Root, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GalleryImageViewModel}">
                                <StackPanel Width="190" ToolTip="{Binding IssueText}" AutomationProperties.Name="{Binding Name}" Background="Transparent">
                                    <StackPanel.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </StackPanel.InputBindings>
                                    <Border Height="300" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="Mark" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="14" Text="&#xE73E;"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DockPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                Padding="10,2" Visibility="{Binding Editable, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Edited" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                        <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter TargetName="Mark" Property="Text" Value="&#xE783;" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ============ Listing preview ============ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DataContext.ShowListing, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="24,20" DataContext="{Binding DataContext, ElementName=Root}" MaxWidth="1100" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="72" Height="72" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{Binding AppIcon}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,20,0,0" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Left" MaxHeight="260"
                                    Visibility="{Binding ListingFeatureGraphic, Converter={StaticResource NullToVisibility}}">
                                <Image Source="{Binding ListingFeatureGraphic}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <ScrollViewer Margin="0,20,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                <ItemsControl ItemsSource="{Binding SelectedGroup.Images}" Focusable="False" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GalleryImageViewModel}">
                                            <Border Height="380" Margin="0,0,10,0" CornerRadius="10" ClipToBounds="True">
                                                <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="An approximation of how the set lines up on a store page. Each store scales and crops differently by device, so treat this as a check of order and flow, not exact pixels." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
