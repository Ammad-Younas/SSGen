<UserControl x:Class="SSGen.App.Views.DesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DesignViewModel}"
             x:Name="Root">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="Design" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0"
                       Text="Choose the best screens, write their captions, pick a design, and render store-ready images." />
        </StackPanel>

        <!-- Nothing to design yet -->
        <Border Grid.Row="1" Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE946;" /></Border>
                <Button DockPanel.Dock="Right" Content="Go to Explore" Command="{Binding GoExploreCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ScreensColumn" Width="340*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="420*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="OptionsColumn" Width="380*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Screens ============================ -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8B9;" /></Border>
                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Screens" />
                            <Border Style="{StaticResource CountBadge}" ToolTip="Chosen for the store / captured">
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center">
                                    <Run Text="{Binding IncludedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Candidates.Count, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                        <WrapPanel>
                            <Button Content="Rank with AI" Command="{Binding RankWithAiCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,6"
                                    IsEnabled="{Binding AiAvailable}" />
                            <Button Content="Rank (no AI)" Command="{Binding RankCommand}" Margin="0,0,8,6" />
                            <Button Content="Clear design" Command="{Binding ClearDesignCommand}" Margin="0,0,8,6"
                                    ToolTip="Start over: ranking, chosen screens, captions, translations and per-screen designs are removed (screenshots stay)" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding AiDescription}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding TargetCount}" AutomationProperties.Name="Screenshots wanted" />
                            <TextBlock Text="Screenshots wanted" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Captured screens">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CandidateViewModel}">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{Binding Thumb}" Width="48" Height="100" Stretch="Uniform" Margin="0,0,10,0" />
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Padding="6,4" HorizontalAlignment="Right" Margin="0,0,0,4"
                                                ToolTip="Delete this screenshot from the project" Command="{Binding DataContext.DeleteScreenCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Label, StringFormat='Delete {0}'}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" />
                                        </Button>
                                        <CheckBox IsChecked="{Binding Included, Mode=OneWay}" Command="{Binding DataContext.ToggleIncludeCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                  ToolTip="Use in the store set" AutomationProperties.Name="{Binding Label, StringFormat='Use {0}'}" MinWidth="0" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Included, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                            <Button Style="{StaticResource IconButton}" Padding="6,4" ToolTip="Move up" Command="{Binding DataContext.MoveUpCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="Move up" ><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="12" /></Button>
                                            <Button Style="{StaticResource IconButton}" Padding="6,4" ToolTip="Move down" Command="{Binding DataContext.MoveDownCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="Move down" ><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" /></Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource CountBadge}" Margin="0,0,6,0" Background="{DynamicResource NavSelectedBrush}" BorderThickness="0"
                                                    Visibility="{Binding Included, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding PositionText}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="{Binding ScoreText}" />
                                        <TextBlock Text="{Binding RejectText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding IsRejected, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                   Visibility="{Binding Included, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding TemplateText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding HasOwnTemplate, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize screens panel"
                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

            <!-- ============================ Preview ============================ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE7B3;" /></Border>
                            <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Preview" />
                        </StackPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="16,10,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="1" MinWidth="110" Margin="8,0,0,0" ItemsSource="{Binding SetLanguages}" SelectedItem="{Binding PreviewLanguage}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="Preview language"
                                      Visibility="{Binding HasExtraLanguages, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PreviewPresets}" SelectedItem="{Binding PreviewPreset}"
                                      AutomationProperties.Name="Preview size">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetOptionViewModel}">
                                        <TextBlock><Run Text="{Binding StoreName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                    </Grid>

                    <!-- Captions of the selected screen -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16" DataContext="{Binding SelectedCandidate}">
                        <TextBlock Text="Headline" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBox Text="{Binding Headline, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnCaptionLostFocus" TextChanged="OnCaptionChanged"
                                 AutomationProperties.Name="Headline" ToolTip="At most about 6 words" />
                        <TextBlock Text="Subheadline (optional)" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBox Text="{Binding Subheadline, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnCaptionLostFocus" TextChanged="OnCaptionChanged"
                                 AutomationProperties.Name="Subheadline" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Reasoning}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Design for this screen" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding DataContext.ScreenTemplateChoices, ElementName=Root}" SelectedItem="{Binding DataContext.ScreenTemplate, ElementName=Root}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.Name="Design for this screen"
                                  ToolTip="Give this screenshot its own template; the others keep the set's template" />
                    </StackPanel>

                    <Grid Margin="16,12,16,0">
                        <TextBlock Style="{StaticResource Caption}" Text="Select a screen to preview it." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Preview, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}" AutomationProperties.Name="Resize options panel"
                          DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

            <!-- ============================ Options ============================ -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Template -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE8A9;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Template" />
                                    <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding Templates.Count}" Style="{StaticResource Caption}" HorizontalAlignment="Center" /></Border>
                                </StackPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" BorderThickness="0" Background="Transparent" Margin="8"
                                     PreviewMouseWheel="OnInnerListWheel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Templates">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Margin" Value="2" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TemplateCardViewModel}">
                                        <StackPanel Width="96" ToolTip="{Binding Description}">
                                            <Border Height="170" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Brand colours -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}" Padding="16,7">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="From app icon" Command="{Binding ColorsFromIconCommand}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE790;" /></Border>
                                        <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Brand colours" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Grid Margin="16,12,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Background="{Binding PrimaryBrush}" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <StackPanel>
                                        <TextBlock Text="Primary" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding Primary, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Primary colour" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Background="{Binding SecondaryBrush}" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <StackPanel>
                                        <TextBlock Text="Secondary" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding Secondary, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Secondary colour" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Store sizes -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE740;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Store sizes" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="16,8,16,16">
                                <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PresetOptionViewModel}">
                                            <DockPanel Margin="0,3" ToolTip="{Binding Notes}">
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Top"
                                                          AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                        <Run Text="{Binding StoreName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="11">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Text" Value="" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Required}" Value="True">
                                                                            <Setter Property="Text" Value="  required" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Size}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Visibility="{Binding ShowAppStoreWarning, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0" CornerRadius="6" Padding="10,8"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                    <TextBlock Text="{Binding AppStoreWarning}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Feature graphic tagline" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBox Text="{Binding Tagline, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Feature graphic tagline"
                                         ToolTip="Shown next to the app name on the 1024 × 500 feature graphic" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PresetSource}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Languages -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE774;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Languages" />
                                    <Border Style="{StaticResource CountBadge}"><TextBlock Style="{StaticResource Caption}" Text="{Binding SetLanguages.Count}" HorizontalAlignment="Center" /></Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="16,10,16,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Primary language (the captions above)" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding AllLanguages}" SelectedItem="{Binding PrimaryLanguage}" DisplayMemberPath="Display"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Primary language" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Also make the images in" />
                                <ItemsControl ItemsSource="{Binding ExtraLanguages}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CountBadge}" Margin="0,0,6,6" Padding="10,2,4,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Button Style="{StaticResource IconButton}" Padding="5,3" Margin="4,0,0,0" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveLanguageCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddLanguageCommand}" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{Binding AllLanguages}" SelectedItem="{Binding LanguageToAdd}" DisplayMemberPath="Display"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Language to add" />
                                </DockPanel>

                                <!-- Translations of the set -->
                                <StackPanel Visibility="{Binding HasExtraLanguages, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Translate with AI" Command="{Binding TranslateCommand}" Margin="8,0,0,0"
                                                IsEnabled="{Binding TranslationAvailable}" ToolTip="Text only: no screenshots are sent" />
                                        <ComboBox ItemsSource="{Binding ExtraLanguages}" SelectedItem="{Binding TranslationLanguage}" DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Translation language" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Captions for the screens in the set. Empty ones use the primary language. AI translations are a draft: have a native speaker check them." />
                                    <ItemsControl ItemsSource="{Binding TranslationRows}" Focusable="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TranslationRowViewModel}">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Headline, UpdateSourceTrigger=LostFocus}" FlowDirection="{Binding Direction}" Margin="0,3,0,0"
                                                             AutomationProperties.Name="{Binding Label, StringFormat='Translated headline for {0}'}" />
                                                    <TextBox Text="{Binding Subheadline, UpdateSourceTrigger=LostFocus}" FlowDirection="{Binding Direction}" Margin="0,3,0,0"
                                                             AutomationProperties.Name="{Binding Label, StringFormat='Translated subheadline for {0}'}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Feature graphic tagline" />
                                    <TextBox Text="{Binding TranslatedTagline, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Translated tagline" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Render -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PanelHeaderIconTile}"><TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xE768;" /></Border>
                                    <TextBlock Style="{StaticResource PanelHeaderTitle}" Text="Render" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="16,12,16,16">
                                <WrapPanel>
                                    <Button Content="Render all" Command="{Binding RenderCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,6" />
                                    <Button Content="Open gallery" Command="{Binding GoGalleryCommand}" Margin="0,0,8,6"
                                            Visibility="{Binding RenderFolder, Converter={StaticResource NullToVisibility}}" />
                                    <Button Content="Open folder" Command="{Binding OpenRendersCommand}" Margin="0,0,8,6"
                                            Visibility="{Binding RenderFolder, Converter={StaticResource NullToVisibility}}" />
                                </WrapPanel>
                                <ProgressBar Value="{Binding ProgressValue}" Height="3" Margin="0,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Report}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RenderReportLine}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                                           Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter TargetName="Mark" Property="Text" Value="&#xE783;" />
                                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
