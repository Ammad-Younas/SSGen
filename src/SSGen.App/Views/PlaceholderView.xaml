<UserControl x:Class="SSGen.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SSGen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlaceholderViewModel}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="48"
                       HorizontalAlignment="Center" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextAlignment="Center" Margin="0,8,0,12"
                       Text="{Binding Description}" />
            <Border HorizontalAlignment="Center" CornerRadius="10" Padding="10,3"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Coming in milestone" /> <Run Text="{Binding Milestone, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
